includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: max
    paths:
        - wp-ai-benchmarks.php
        - src
    excludePaths:
        - vendor
    scanDirectories:
        - vendor/wordpress/wp-ai-client
    bootstrapFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - phpstan-bootstrap.php
    ignoreErrors:
        # set_error_handler with null-returning closure is intentional
        - '#Parameter \#1 \$callback of function set_error_handler expects#'
        # Shutdown handler sets this property asynchronously
        - '#Strict comparison using !== between null and null will always evaluate to false#'
