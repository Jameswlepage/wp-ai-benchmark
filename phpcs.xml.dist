<?xml version="1.0"?>
<ruleset name="WP AI Benchmarks">
	<description>Custom ruleset for WP AI Benchmarks plugin.</description>

	<!-- What to scan -->
	<file>./wp-ai-benchmarks.php</file>
	<file>./src</file>

	<!-- Exclude patterns -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>

	<!-- How to scan -->
	<arg value="sp"/> <!-- Show sniff and progress -->
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- Rules: WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Allow short array syntax -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>

		<!-- We use namespaces and PSR-4 autoloading patterns -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<!-- Allow modern PHP features -->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<properties>
			<property name="allowed_custom_properties" type="array">
				<element value="test_id"/>
				<element value="model_answer"/>
				<element value="correct_answer"/>
			</property>
		</properties>
	</rule>

	<!-- Verify compatibility with PHP 8.4 -->
	<config name="testVersion" value="8.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- WordPress minimum version -->
	<config name="minimum_wp_version" value="6.9"/>

	<!-- Text domain for i18n -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-ai-benchmarks"/>
			</property>
		</properties>
	</rule>

	<!-- Allow certain functions in CLI context -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
	</rule>

	<!-- Prefix everything with the plugin prefix -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wp_ai_bench"/>
				<element value="WordPress\AI_Benchmark"/>
				<element value="WP_AI_BENCH"/>
			</property>
		</properties>
	</rule>
</ruleset>
